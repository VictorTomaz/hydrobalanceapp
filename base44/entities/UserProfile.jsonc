{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "weight": {
      "type": "number",
      "description": "Body weight"
    },
    "weight_unit": {
      "type": "string",
      "enum": [
        "lbs",
        "kg"
      ],
      "default": "lbs"
    },
    "unit_preference": {
      "type": "string",
      "enum": [
        "oz",
        "ml"
      ],
      "default": "oz"
    },
    "activity_level": {
      "type": "string",
      "enum": [
        "sedentary",
        "moderate",
        "active"
      ],
      "default": "moderate"
    },
    "daily_goal_ml": {
      "type": "number",
      "description": "Calculated daily water goal in ml"
    },
    "reminder_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of HH:MM times for water reminders"
    },
    "bedtime": {
      "type": "string",
      "description": "HH:MM bedtime"
    },
    "winddown_offset_minutes": {
      "type": "number",
      "default": 45
    },
    "enabled_activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of default wind-down activities the user has enabled"
    },
    "custom_activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "User-created custom wind-down activities"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "canceled"
      ],
      "default": "none",
      "description": "Set to 'active' by the payments webhook when a subscription is paid, 'canceled' when it ends."
    },
    "trial_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp the 7-day app-level free trial started, set on onboarding completion."
    },
    "subscription_product_id": {
      "type": "string",
      "description": "Apple product identifier that was purchased."
    },
    "subscription_expires_at": {
      "type": "string",
      "description": "ISO date of the current subscription period's end."
    },
    "subscription_environment": {
      "type": "string",
      "description": "'production' or 'sandbox' \u2014 which Apple environment the subscription was verified in."
    },
    "subscription_original_transaction_id": {
      "type": "string",
      "description": "Apple's stable id for the subscription, used to match server notifications to the user."
    },
    "subscription_last_notification": {
      "type": "string",
      "description": "Last App Store server notification type received, for debugging."
    }
  },
  "required": [
    "weight",
    "activity_level"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}