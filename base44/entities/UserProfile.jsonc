{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "weight": {
      "type": "number",
      "description": "Body weight"
    },
    "weight_unit": {
      "type": "string",
      "enum": [
        "lbs",
        "kg"
      ],
      "default": "lbs"
    },
    "unit_preference": {
      "type": "string",
      "enum": [
        "oz",
        "ml"
      ],
      "default": "oz"
    },
    "activity_level": {
      "type": "string",
      "enum": [
        "sedentary",
        "moderate",
        "active"
      ],
      "default": "moderate"
    },
    "daily_goal_ml": {
      "type": "number",
      "description": "Calculated daily water goal in ml"
    },
    "reminder_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of HH:MM times for water reminders"
    },
    "bedtime": {
      "type": "string",
      "description": "HH:MM bedtime"
    },
    "winddown_offset_minutes": {
      "type": "number",
      "default": 45
    },
    "enabled_activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of default wind-down activities the user has enabled"
    },
    "custom_activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "User-created custom wind-down activities"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "weight",
    "activity_level"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}